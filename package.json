{
  "name": "@techbykyle/svg-logo",
  "version": "0.2.6",
  "description": "A lightweight, tree-shakeable React SVG brand-logo library.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/types/icons/*.d.mts",
        "default": "./dist/esm/icons/*.js"
      },
      "require": {
        "types": "./dist/types/icons/*.d.cts",
        "default": "./dist/cjs/icons/*.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.mts",
        "default": "./dist/esm/metadata.js"
      },
      "require": {
        "types": "./dist/metadata.d.cts",
        "default": "./dist/cjs/metadata.js"
      }
    },
    "./metadata.json": "./dist/metadata.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons.json",
    "icons.schema.json",
    "BRAND_ASSETS.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.js && node scripts/build-types.js",
    "check": "node scripts/check-package.js && node scripts/check-variants.js",
    "test": "node scripts/test-consumers.js",
    "test:consumers": "node scripts/test-consumers.js",
    "version": "npm test",
    "prepack": "npm run build && npm run check"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react",
    "svg",
    "brand",
    "logo",
    "icons",
    "icon-pack",
    "component",
    "brand-icons"
  ],
  "author": "techbykyle",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbykyle/svg-logo.git"
  },
  "homepage": "https://github.com/techbykyle/svg-logo#readme",
  "bugs": {
    "url": "https://github.com/techbykyle/svg-logo/issues"
  }
}
